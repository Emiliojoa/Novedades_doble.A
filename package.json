{
  "name": "doble-a-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "admin:create": "npm run admin:create -w server",
    "db:migrate": "npm run db:migrate -w server",
    "test:e2e": "playwright test",
    "db:check": "npm run db:check -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
