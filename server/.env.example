API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
# Supabase PostgreSQL (Session pooler, puerto 5432). Contraseña URL-encoded.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Opcional, CA propia. Por defecto se incluye la CA pública de Supabase.
# DATABASE_CA_PATH=./config/certs/supabase-ca.crt
# Alternativa local explícita: DATABASE_PROVIDER=sqlite y DATABASE_PATH=./data/store.db
# Solo para npm run admin:create. Completar localmente; no versionar .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
